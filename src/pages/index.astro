---
import Sheet from '../layouts/Sheet.astro';
import Zone from '../components/Zone.astro';
import Nav from '../components/Nav.astro';
import Revisions from '../components/Revisions.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import Boards from '../components/Boards.astro';
import TitleBlock from '../components/TitleBlock.astro';
import { getSheets, getLogEntries } from '../lib/projects';
import { Picture } from 'astro:assets';
import authorPhoto from '../assets/img/about/author.jpg';

const sheets = await getSheets();
const logEntries = await getLogEntries();
const featured = sheets.filter((s) => s.entry.data.featured);
---

<Sheet
  title="Alex Camilo, electrical engineer"
  description="Electrical engineer in Worcester, MA. Circuit boards and the firmware that runs on them: motor drivers for MRI-compatible surgical robots, conference badges, robots for teaching."
  ogImage={sheets[0].hero}
  bare
>
  <Zone letter="A" as="header" first>
    <div class="intro-grid">
      <Picture
        class="portrait"
        src={authorPhoto}
        formats={['avif', 'webp']}
        widths={[160, 220, authorPhoto.width]}
        sizes="(max-width: 540px) 80px, (max-width: 860px) 140px, 180px"
        width={authorPhoto.width}
        height={authorPhoto.height}
        alt="Alex Camilo"
        loading="eager"
      />
      <h1 class="name">Alex Camilo</h1>
      <div class="intro-nav"><Nav /></div>
      <p class="intro lead">
        I'm an electrical engineer in Worcester, MA. I design circuit boards and write the
        firmware that runs on them: motor drivers for MRI-compatible surgical robots,
        conference badges, robots for teaching. I've done concept, parts selection,
        schematic capture, PCB layout, bring-up, production, and retail.
      </p>
      <div class="head-rev">
        <Revisions entries={logEntries} />
      </div>
    </div>
  </Zone>

  <main id="main">
    <Zone letter="B" aria-labelledby="index-heading">
      <h2 class="section-title" id="index-heading">
        Projects <span class="count">{sheets.length} sheets</span>
      </h2>
      <ProjectIndex sheets={sheets} />
    </Zone>

    <Boards sheets={featured} letter="C" />
  </main>

  <Zone letter="D" as="footer" class="zone-block">
    <TitleBlock
      title="Alex Camilo"
      id={`0/${sheets.length}`}
      forText="Electrical engineer, Worcester, MA"
      sheet="/"
      file="src/pages/index.astro"
      extra={[
        { label: 'Email', value: 'alex.camilo+p@gmail.com', href: 'mailto:alex.camilo+p@gmail.com', span: 3 },
        { label: 'GitHub', value: 'github.com/acamilo', href: 'https://github.com/acamilo', span: 3 },
        { label: 'Feed', value: 'RSS', href: '/feed.xml', span: 6 },
      ]}
    />
  </Zone>
</Sheet>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 180px) minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 1.5rem var(--gap);
    align-items: start;
  }

  .intro-grid > :global(picture) {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: stretch;
    position: relative;
  }

  .intro-grid :global(.portrait) {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--fg);
  }

  .name {
    grid-column: 2;
  }

  .intro-nav {
    grid-column: 3;
    justify-self: end;
    align-self: center;
  }

  .intro {
    grid-column: 2;
    grid-row: 2;
  }

  .head-rev {
    grid-column: 3;
    grid-row: 2;
  }

  .zone-block {
    padding: 0;
    display: flex;
    justify-content: flex-end;
  }

  .zone-block :global(.tb) {
    margin-top: 2.5rem;
  }

  @media (max-width: 860px) {
    .intro-grid > :global(picture) {
      grid-row: 1 / 3;
      position: static;
    }

    .intro-grid :global(.portrait) {
      position: static;
      height: auto;
    }

    .intro-grid {
      grid-template-columns: 140px minmax(0, 1fr);
      gap: 1rem;
    }

    .intro-nav {
      grid-column: 2;
      grid-row: 2;
      justify-self: start;
    }

    .intro {
      grid-column: 1 / -1;
      grid-row: 3;
    }

    .head-rev {
      grid-column: 1 / -1;
      grid-row: 4;
      margin-top: 0.5rem;
    }

    .zone-block {
      display: block;
    }

    .zone-block :global(.tb) {
      margin-top: 0;
    }
  }

  @media (max-width: 540px) {
    .intro-grid {
      grid-template-columns: 80px minmax(0, 1fr);
    }

    .intro-grid > :global(picture) {
      grid-row: 1;
    }

    .name {
      align-self: center;
    }

    .intro-nav {
      grid-column: 1 / -1;
    }
  }
</style>
