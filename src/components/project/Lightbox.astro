---
// Native <dialog> viewer for the image figures on a project sheet.
//
// Progressive: every image figure is already a link to its largest generated
// copy, so with JavaScript off a click just opens that file. With JavaScript
// the click is intercepted and the same file opens here, with the caption,
// Esc and backdrop to close, left/right to step between figures, and focus
// handed back to the figure that was clicked.
//
// The dialog is rendered inside the sheet interior, so it inherits the live
// --mask / --mask-deep the scroll engine writes there.
---

<dialog class="lb" aria-label="Figure viewer">
  <div class="lb-stage">
    <img class="lb-img" alt="" decoding="async" />
  </div>
  <div class="lb-bar">
    <p class="lb-cap">
      <b class="lb-no"></b>
      <span class="lb-text"></span>
    </p>
    <div class="lb-buttons">
      <button class="lb-btn lb-prev" type="button">Previous</button>
      <button class="lb-btn lb-next" type="button">Next</button>
      <button class="lb-btn lb-close" type="button">Close</button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lb');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lb]')];

  if (dialog && links.length) {
    const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
    const no = dialog.querySelector<HTMLElement>('.lb-no')!;
    const text = dialog.querySelector<HTMLElement>('.lb-text')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lb-prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lb-next')!;
    const close = dialog.querySelector<HTMLButtonElement>('.lb-close')!;

    let index = 0;
    let trigger: HTMLAnchorElement | null = null;

    if (links.length < 2) {
      prev.hidden = true;
      next.hidden = true;
    }

    const show = (n: number): void => {
      index = (n + links.length) % links.length;
      const a = links[index];
      const w = Number(a.dataset.w) || 0;
      img.src = a.href;
      img.alt = a.dataset.alt ?? '';
      if (w) {
        img.width = w;
        img.height = Number(a.dataset.h) || 0;
        // never wider than the file really is, and never wider than the screen
        img.style.maxWidth = `min(100%, ${w}px)`;
      }
      no.textContent = `Fig. ${a.dataset.no ?? ''}`;
      text.textContent = a.dataset.cap ?? '';
      dialog.setAttribute('aria-label', `Figure ${a.dataset.no ?? ''}`);
      trigger = a;
    };

    links.forEach((a, n) => {
      a.addEventListener('click', (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        show(n);
        dialog.showModal();
        close.focus();
      });
    });

    dialog.addEventListener('click', (e) => {
      // only the backdrop area of the dialog itself closes it
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('lb-stage')) {
        dialog.close();
      }
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(index + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(index - 1);
      }
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    close.addEventListener('click', () => dialog.close());

    // Esc, the close button and the backdrop all end up here.
    dialog.addEventListener('close', () => {
      trigger?.focus();
      img.removeAttribute('src');
    });
  }
</script>

<style>
  .lb {
    width: min(100vw, 100%);
    max-width: 100vw;
    max-height: 100vh;
    height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--silk);
    overflow: hidden;
  }

  .lb::backdrop {
    background: rgba(8, 8, 8, 0.86);
  }

  .lb[open] {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .lb-stage {
    display: grid;
    place-items: center;
    padding: 1.5rem 1.5rem 0;
    min-height: 0;
  }

  .lb-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1.5px solid var(--silk-line);
  }

  .lb-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.7rem 1.5rem 0.9rem;
    background: var(--mask-deep);
    border-top: 1.5px solid var(--silk-line);
  }

  .lb-cap {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--silk-dim);
    max-width: 62ch;
  }

  .lb-no {
    font-family: var(--font-num);
    font-weight: 400;
    color: var(--silk);
    margin-right: 0.6em;
  }

  .lb-buttons {
    display: flex;
    gap: 0.6rem;
    margin-left: auto;
  }

  .lb-btn {
    font: inherit;
    font-size: 0.85rem;
    color: var(--silk);
    background: transparent;
    border: 1.5px solid var(--silk-line);
    padding: 0.25rem 0.8rem;
    cursor: pointer;
  }

  .lb-btn:hover {
    border-color: var(--gold);
  }

  .lb-btn[hidden] {
    display: none;
  }

  /* the page must not scroll behind the open viewer */
  :global(html:has(dialog.lb[open])) {
    overflow: hidden;
  }

  @media (max-width: 860px) {
    .lb-stage {
      padding: 1rem 1rem 0;
    }

    .lb-bar {
      padding: 0.6rem 1rem 0.7rem;
    }
  }
</style>
